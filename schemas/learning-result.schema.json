{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://richmack.local/schemas/learning-result.schema.json",
  "title": "Richmack Learning Result",
  "description": "Shared result format for Richmack Learning Arcade games.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "student_id",
    "game_id",
    "subject",
    "skill",
    "duration_seconds",
    "timestamp"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "student_id": {
      "type": "string",
      "minLength": 1
    },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "accuracy": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
